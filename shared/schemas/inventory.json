{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InventoryPayload",
  "type": "object",
  "required": ["agent_token", "hostname", "tier", "collectors", "collected_at"],
  "properties": {
    "agent_token": { "type": "string" },
    "hostname": { "type": "string" },
    "tier": { "enum": ["t0", "t1", "t2", "t3"] },
    "collected_at": { "type": "string", "format": "date-time" },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "data", "hash"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "data": {},
          "hash": { "type": "string" },
          "duration_ms": { "type": "integer" },
          "error": { "type": ["string", "null"] }
        }
      }
    }
  }
}
